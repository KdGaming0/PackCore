{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "PackCore is a companion mod for the SkyBlock Enhanced modpacks, featuring a Hypixel SkyBlock-themed start menu, plus more!",
  "authors": ["Kd_Gaming1"],
  "contact": {
    "homepage": "https://modrinth.com/project/V3FnL7QV",
    "sources": "https://github.com/KdGaming0/PackCore"
  },
  "license": "PolyForm Perimeter License 1.0.1",
  "icon": "assets/packcore/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.github.kd_gaming1.packcore.PackCorePreLaunch"
    ],
    "client": [
      "com.github.kd_gaming1.packcore.PackCore"
    ]
  },
  "mixins": [ "packcore.mixins.json" ],
  "depends": {
    "fabricloader": ">=${fabricloader}",
    "minecraft": "${minecraft}",
    "uilib": ">=${uilib_version}"
  },
  "suggests": {
    "scamscreener": "*",
    "scaleme": "*"
  }
}
