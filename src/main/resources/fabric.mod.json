{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "PackCore is a companion mod for SkyBlock Enhanced modpacks, featuring a Hypixel SkyBlock-themed start menu, plus more!",
  "authors": [ "Kd_Gaming1" ],
  "contact": {
    "homepage": "https://modrinth.com/project/V3FnL7QV",
    "sources": "https://github.com/KdGaming0/PackCore"
  },
  "license": "PolyForm Perimeter License 1.0.1",
  "icon": "assets/packcore/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.github.kd_gaming1.packcore.prelaunch.PreLaunchWizardInitializer"
    ],
    "client": [
      "com.github.kd_gaming1.packcore.PackCore"
    ]
  },
  "mixins": [ "packcore.mixins.json" ],
  "depends": {
    "fabric-api": "*",
    "fabricloader": ">=0.17.2",
    "java": ">=21",
    "minecraft": "~${minor_mc_version}"
