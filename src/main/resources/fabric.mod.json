{
  "schemaVersion": 1,
  "id": "packcore",
  "version": "${version}",
  "name": "PackCore",
  "description": "PackCore is a companion mod for SkyBlock Enhanced modpacks, featuring a Hypixel SkyBlock-themed start menu, plus more!",
  "authors": [ "Kd_Gaming1" ],
  "contact": {
    "homepage": "https://modrinth.com/project/V3FnL7QV",
    "sources": "https://github.com/KdGaming0/PackCore"
  },
  "license": "PolyForm Perimeter License 1.0.1",
  "icon": "assets/packcore/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.github.kd_gaming1.packcore.wizard.PreLaunchWizardInitializer"
    ],
    "main": [
      "com.github.kd_gaming1.packcore.PackCore"
    ],
    "client": [
      "com.github.kd_gaming1.packcore.PackCoreClient"
    ]
  },
  "mixins": [ "packcore.mixins.json" ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "vistas": ">=${vistas_version}",
    "owo": ">=${owo_version}"
  },
  "suggests": {
    "sodium": ">=0.6.0"
  }
}
